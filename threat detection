import 'package:flutter/material.dart';

import 'network_security.dart';
import 'app_security.dart';
import 'password_security.dart';
import 'threat_detection.dart';
import 'scan_history.dart';
import 'device_security.dart';
import 'security_recommendations.dart';
import 'security_assessment.dart';
import 'full_security_scan.dart';
import 'history_manager.dart';

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();

  await HistoryManager.loadHistory();

  runApp(const SentinelXApp());
}

class SentinelXApp extends StatelessWidget {
  const SentinelXApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'SentinelX',
      theme: ThemeData(
        brightness: Brightness.dark,
        scaffoldBackgroundColor:
            const Color(0xFF0B1020),
        colorScheme: ColorScheme.fromSeed(
          seedColor: Colors.cyan,
          brightness: Brightness.dark,
        ),
        useMaterial3: true,
      ),
      home: const SentinelXHome(),
    );
  }
}

class SentinelXHome extends StatefulWidget {
  const SentinelXHome({super.key});

  @override
  State<SentinelXHome> createState() =>
      _SentinelXHomeState();
}

class _SentinelXHomeState
    extends State<SentinelXHome> {
  bool networkChecked = false;
  bool appScanCompleted = false;
  bool threatScanCompleted = false;
  bool passwordSecure = false;
  bool deviceChecked = false;

  int get securityScore {
    int score = 10;

    if (networkChecked) {
      score += 18;
    }

    if (appScanCompleted) {
      score += 18;
    }

    if (threatScanCompleted) {
      score += 24;
    }

    if (passwordSecure) {
      score += 20;
    }

    if (deviceChecked) {
      score += 10;
    }

    return score;
  }

  String get securityLevel {
    if (securityScore >= 80) {
      return 'Good Security Level';
    } else if (securityScore >= 60) {
      return 'Moderate Security Level';
    } else {
      return 'Needs Attention';
    }
  }

  Color get scoreColor {
    if (securityScore >= 80) {
      return Colors.greenAccent;
    } else if (securityScore >= 60) {
      return Colors.orangeAccent;
    } else {
      return Colors.redAccent;
    }
  }

  @override
  Widget build(BuildContext context) {
    final Color scoreColor = this.scoreColor;

    return Scaffold(
      appBar: AppBar(
        title: const Row(
          children: [
            Icon(
              Icons.shield,
              color: Colors.cyan,
            ),
            SizedBox(width: 10),
            Text(
              'SentinelX',
              style: TextStyle(
                fontWeight: FontWeight.bold,
              ),
            ),
          ],
        ),
        backgroundColor:
            const Color(0xFF11182D),
      ),

      body: SingleChildScrollView(
        padding:
            const EdgeInsets.all(20),

        child: Column(
          crossAxisAlignment:
              CrossAxisAlignment.start,

          children: [
            const Text(
              'Cybersecurity Dashboard',
              style: TextStyle(
                fontSize: 24,
                fontWeight:
                    FontWeight.bold,
              ),
            ),

            const SizedBox(height: 8),

            Text(
              'Monitor and protect your device',
              style: TextStyle(
                color:
                    Colors.grey.shade400,
                fontSize: 15,
              ),
            ),

            const SizedBox(height: 25),

            // SYSTEM STATUS
            Container(
              width: double.infinity,
              padding:
                  const EdgeInsets.all(20),

              decoration:
                  BoxDecoration(
                color:
                    const Color(0xFF151F38),
                borderRadius:
                    BorderRadius.circular(18),
                border: Border.all(
                  color: Colors.cyan
                      .withOpacity(0.3),
                ),
              ),

              child: const Column(
                children: [
                  Icon(
                    Icons.security,
                    size: 55,
                    color: Colors.cyan,
                  ),

                  SizedBox(height: 12),

                  Text(
                    'SYSTEM STATUS',
                    style: TextStyle(
                      fontSize: 13,
                      color: Colors.grey,
                      letterSpacing: 1.5,
                    ),
                  ),

                  SizedBox(height: 6),

                  Text(
                    'SECURE',
                    style: TextStyle(
                      fontSize: 28,
                      fontWeight:
                          FontWeight.bold,
                      color:
                          Colors.greenAccent,
                    ),
                  ),
                ],
              ),
            ),

            const SizedBox(height: 20),

            // SECURITY SCORE
            Container(
              width: double.infinity,
              padding:
                  const EdgeInsets.all(20),

              decoration:
                  BoxDecoration(
                color:
                    const Color(0xFF151F38),
                borderRadius:
                    BorderRadius.circular(18),
                border: Border.all(
                  color: scoreColor
                      .withOpacity(0.3),
                ),
              ),

              child: Column(
                children: [
                  Row(
                    mainAxisAlignment:
                        MainAxisAlignment
                            .center,
                    children: [
                      Icon(
                        Icons.shield,
                        color:
                            scoreColor,
                      ),

                      const SizedBox(
                        width: 8,
                      ),

                      const Text(
                        'SECURITY SCORE',
                        style: TextStyle(
                          fontSize: 14,
                          color: Colors.grey,
                          letterSpacing:
                              1.5,
                        ),
                      ),
                    ],
                  ),

                  const SizedBox(
                    height: 15,
                  ),

                  Text(
                    '$securityScore / 100',
                    style: TextStyle(
                      fontSize: 38,
                      fontWeight:
                          FontWeight.bold,
                      color:
                          scoreColor,
                    ),
                  ),

                  const SizedBox(
                    height: 8,
                  ),

                  Text(
                    securityLevel,
                    style: TextStyle(
                      color:
                          Colors.grey.shade300,
                      fontSize: 15,
                    ),
                  ),

                  const SizedBox(
                    height: 15,
                  ),

                  LinearProgressIndicator(
                    value:
                        securityScore / 100,
                    minHeight: 9,
                    borderRadius:
                        BorderRadius.circular(
                      10,
                    ),
                    backgroundColor:
                        Colors.grey.shade800,
                    valueColor:
                        AlwaysStoppedAnimation<
                            Color>(
                      scoreColor,
                    ),
                  ),
                ],
              ),
            ),

            const SizedBox(height: 25),

            // FULL SECURITY SCAN
            SizedBox(
              width: double.infinity,
              height: 55,

              child:
                  ElevatedButton.icon(
                onPressed: () async {
                  await Navigator.push(
                    context,
                    MaterialPageRoute(
                      builder: (context) =>
                          const FullSecurityScanPage(),
                    ),
                  );
                },

                icon: const Icon(
                  Icons.radar,
                ),

                label: const Text(
                  'RUN FULL SECURITY SCAN',
                  style: TextStyle(
                    fontWeight:
                        FontWeight.bold,
                  ),
                ),
              ),
            ),

            const SizedBox(height: 25),

            const Text(
              'Security Tools',
              style: TextStyle(
                fontSize: 20,
                fontWeight:
                    FontWeight.bold,
              ),
            ),

            const SizedBox(height: 15),

            // NETWORK SECURITY
            _securityCard(
              icon: Icons.wifi,
              title:
                  'Network Security',
              subtitle: networkChecked
                  ? 'Network check completed'
                  : 'Check network and connection security',
              completed:
                  networkChecked,
              onTap: () async {
                await Navigator.push(
                  context,
                  MaterialPageRoute(
                    builder: (context) =>
                        const NetworkSecurityPage(),
                  ),
                );

                if (!mounted) return;

                setState(() {
                  networkChecked = true;
                });
              },
            ),

            // APP SECURITY
            _securityCard(
              icon: Icons.apps,
              title: 'App Security',
              subtitle: appScanCompleted
                  ? 'Application scan completed'
                  : 'Review installed applications',
              completed:
                  appScanCompleted,
              onTap: () async {
                await Navigator.push(
                  context,
                  MaterialPageRoute(
                    builder: (context) =>
                        const AppSecurityPage(),
                  ),
                );

                if (!mounted) return;

                setState(() {
                  appScanCompleted = true;
                });
              },
            ),

            // PASSWORD SECURITY
            _securityCard(
              icon: Icons.lock,
              title:
                  'Password Security',
              subtitle: passwordSecure
                  ? 'Strong password verified'
                  : 'Password does not meet all requirements',
              completed:
                  passwordSecure,
              onTap: () async {
                final result =
                    await Navigator.push<bool>(
                  context,
                  MaterialPageRoute(
                    builder: (context) =>
                        const PasswordSecurityPage(),
                  ),
                );

                if (!mounted) return;

                setState(() {
                  passwordSecure =
                      result == true;
                });
              },
            ),

            // THREAT DETECTION
            _securityCard(
              icon:
                  Icons.warning_amber_rounded,
              title:
                  'Threat Detection',
              subtitle: threatScanCompleted
                  ? 'Threat scan completed'
                  : 'Identify potential security threats',
              completed:
                  threatScanCompleted,
              onTap: () async {
                await Navigator.push(
                  context,
                  MaterialPageRoute(
                    builder: (context) =>
                        const ThreatDetectionPage(),
                  ),
                );

                if (!mounted) return;

                setState(() {
                  threatScanCompleted =
                      true;
                });
              },
            ),

            // DEVICE SECURITY
            _securityCard(
              icon:
                  Icons.phone_android,
              title:
                  'Device Security',
              subtitle: deviceChecked
                  ? 'Device information checked'
                  : 'Check basic device security information',
              completed:
                  deviceChecked,
              onTap: () async {
                await Navigator.push(
                  context,
                  MaterialPageRoute(
                    builder: (context) =>
                        const DeviceSecurityPage(),
                  ),
                );

                if (!mounted) return;

                setState(() {
                  deviceChecked = true;
                });
              },
            ),

            // SECURITY RECOMMENDATIONS
            _securityCard(
              icon:
                  Icons.lightbulb_outline,
              title:
                  'Security Recommendations',
              subtitle:
                  'Get tips to improve device security',
              completed: false
              onTap: () {
                Navigator.push(
                  context,
                  MaterialPageRoute(
                    builder: (context) =>
                        const SecurityRecommendationsPage(),
                  ),
                );
              },
            ),

            // SECURITY ASSESSMENT
            _securityCard(
              icon: Icons.assessment,
              title:
                  'Security Assessment',
              subtitle:
                  'View your overall security assessment',
              completed: false
              onTap: () {
                Navigator.push(
                  context,
                  MaterialPageRoute(
                    builder: (context) =>
                        SecurityAssessmentPage(
                      networkChecked:
                          networkChecked,
                      appScanCompleted:
                          appScanCompleted,
                      threatScanCompleted:
                          threatScanCompleted,
                      passwordSecure:
                          passwordSecure,
                      deviceChecked:
                          deviceChecked,
                    ),
                  ),
                );
              },
            )

            // SCAN HISTORY
            _securityCard(
              icon: Icons.history,
              title:
                  'Scan History',
              subtitle:
                  'View security scan results',
              completed: false
              onTap: () {
                Navigator.push(
                  context,
                  MaterialPageRoute(
                    builder: (context) =>
                        const ScanHistoryPage(),
                  ),
                );
              },
            ),

            const SizedBox(height: 20),

            // INFORMATION BOX
           Container(
  width: double.infinity,
  padding: const EdgeInsets.all(15),
  decoration: BoxDecoration(
    color: const Color(0xFF151F38),
    borderRadius: BorderRadius.circular(12),
    border: Border.all(
      color: Colors.cyan.withOpacity(0.2),
    ),
  ),
  child: const Row(
    crossAxisAlignment: CrossAxisAlignment.start,
    children: [
      Icon(
        Icons.info_outline,
        color: Colors.cyan,
      ),
      SizedBox(width: 10),
      Expanded(
        child: Text(
          'The security score is calculated '
          'from completed security checks '
          'and password strength.',
        ),
      ),
    ],
  ),
),
          ],
        ),
      ),
    ),
    
  Widget _securityCard({
    required IconData icon,
    required String title,
    required String subtitle,
    required bool completed,
    required VoidCallback onTap,
  }) {
    return Card(
      margin:
          const EdgeInsets.only(
        bottom: 12,
      ),

      color:
          const Color(0xFF151F38),

      child: InkWell(
        onTap: onTap,
        borderRadius:
            BorderRadius.circular(12),

        child: ListTile(
          contentPadding:
              const EdgeInsets.symmetric(
            horizontal: 18,
            vertical: 8,
          ),

          leading: CircleAvatar(
            backgroundColor:
                Colors.cyan
                    .withOpacity(0.15),

            child: Icon(
              icon,
              color: Colors.cyan,
            ),
          ),

          title: Text(
            title,
            style: const TextStyle(
              fontWeight:
                  FontWeight.bold,
            ),
          ),

          subtitle:
              Text(subtitle),

          trailing: Icon(
            completed
                ? Icons.check_circle
                : Icons.arrow_forward_ios,
            size: 18,
            color: completed
                ? Colors.greenAccent
                : Colors.grey,
          ),
        ),
      ),
    );
  }
}
